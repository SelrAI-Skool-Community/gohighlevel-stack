# ============================================
# GoHighLevel credentials
# ============================================
# Save this file as  ghl.env  (drop the .template) and fill in the two
# required values. ghl.env is git-ignored and never leaves this machine.
# ============================================

# REQUIRED, your GHL Private Integration Token.
# Where to get it: GHL > Settings (gear, bottom left) > Private Integrations >
# Create new integration. Tick the scopes you need, create it, and copy the
# token. It is shown once, so paste it here straight away.
# It looks like:  pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GHL_API_KEY=your_token_here

# REQUIRED, your GHL Location ID (the sub-account this works on).
# Where to find it: look at your GHL URL. It reads
#   app.gohighlevel.com/v2/location/XXXXXXXXXXXXXXXX/dashboard
# Copy the XXXXXXXXXXXXXXXX part.
GHL_LOCATION_ID=your_location_id_here

# OPTIONAL, your main pipeline, so you do not have to name it every time.
# Ask Claude "show me my GHL pipelines" after setup, then paste the id here.
GHL_PIPELINE_ID=

# OPTIONAL, used for calendar and appointment queries. Use your own IANA
# timezone, the same one set in GHL > Settings > Business Profile.
# Example: UTC. Replace it with the same IANA timezone set in GHL.
GHL_TIMEZONE=

# Leave these alone unless GoHighLevel tells you otherwise.
GHL_BASE_URL=https://services.leadconnectorhq.com
GHL_API_VERSION=2021-07-28
